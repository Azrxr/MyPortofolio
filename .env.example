# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env
# ============================================

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com/
# 2. Select your project (or create new one)
# 3. Go to Project Settings > General
# 4. Scroll down to "Your apps" section
# 5. Click on Web app (or add new web app)
# 6. Copy the config values from firebaseConfig object

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# Get these values from Cloudinary Dashboard:
# 1. Go to https://cloudinary.com/ and sign in
# 2. Go to Dashboard to get your Cloud Name
# 3. For Upload Preset:
#    - Go to Settings > Upload
#    - Scroll to "Upload presets"
#    - Create new preset with "Unsigned" mode
#    - Copy the preset name

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name

# ============================================
# ADMIN CONFIGURATION
# ============================================
# List of email addresses that can access admin panel
# Separate multiple emails with commas (no spaces)
# These emails must be registered via Google Sign-In

VITE_ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
